{
  // Cloudflare settings: serve /public as the website, run worker.js for the portal login.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jamie-de-rooij",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
