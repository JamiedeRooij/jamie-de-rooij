{
  // Cloudflare settings: serve /public as the website, run worker.js for the portal login.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jamie-de-rooij",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  // keep values added in the Cloudflare dashboard when GitHub pushes a new version
  "keep_vars": true,
  // gives the Worker the time this version went live, for "Last updated" in the footer
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
